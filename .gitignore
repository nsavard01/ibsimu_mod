# CMake out-of-source build dir -- everything cmake/make produces lives
# here, nothing generated should ever land inside src/ or tests/ again.
build/
build-*/

*~
*.o
*.lo
*.la
*.pc

# Old autotools cruft (kept here in case anyone still runs autoreconf
# locally out of habit -- harmless if unused)
Makefile
Makefile.in
aclocal.m4
autom4te.cache
config.guess
config.log
config.status
config.sub
configure
depcomp
install-sh
ltmain.sh
libtool
missing
m4

doc/Doxyfile
doc/Doxyfile_web
doc/html
doc/webdoc

tests/*.log
tests/*.trs
tests/*.dat
tests/*.png
tests/*.ps
tests/*.pdf
tests/*_vout.txt
tests/*_out.txt
